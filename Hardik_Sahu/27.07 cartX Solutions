Solution of Question 1 :

select name,category,price,stock_quantity
from products
where stock_quantity < 10
order by stock_quantity asc;

Solution of question 2 :

select o.payment_method,round(sum(p.price * oi.quantity * (1 - oi.discount_pct / 100.0)), 2)
as total_revenue
from orders o
join order_items oi
on o.order_id = oi.order_id
join products p
on oi.product_id = p.product_id
where o.status = 'Delivered'
group by o.payment_method;

Solution of question 3 :

select c.full_name,c.city,c.account_type,count(o.order_id) as total_orders
from customers c
join orders o on c.customer_id = o.customer_id
group by c.customer_id,c.full_name,c.city
having count(o.order_id) > 1;

Solution of question 4:

with product_revenue as (
 select p.product_id,p.name,p.category,sum(p.price * oi.quantity * (1 - oi.discount_pct / 100.0)) as revenue from products p
join order_items oi
on p.product_id = oi.product_id
group by
p.product_id,
p.name,
p.category),
ranked_products as (
select
 name,
 category,
 revenue,
 rank() over (
 partition by category
 order by revenue desc) as category_rank,
  round(revenue * 100.0 /
  sum(revenue) over (partition by category), 2 ) as percent_of_category_total
 from product_revenue)
select name,category,round(revenue, 2) as revenue,
category_rank,
percent_of_category_total
from ranked_products
order by category, category_rank;
